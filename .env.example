# NSIA Insurance partner API — see docs/nsia-integration.md
# Bearer token issued to your partner account. Required for authenticated calls.
NSIA_ACCESS_TOKEN=
# "test" (default) or "live". Only switch to live once NSIA has approved the integration.
NSIA_ENV=test
# Optional: overrides the base URL entirely.
# NSIA_BASE_URL=

# Fortis Global partner API
FORTIS_CLIENT_ID=
FORTIS_CLIENT_SECRET=

# Optional outbound proxy used for all insurer calls.
# FIXIE_URL=
