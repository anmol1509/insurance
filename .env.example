# NSIA Insurance partner API — see docs/nsia-integration.md
# Bearer token issued to your partner account. Required for authenticated calls.
NSIA_ACCESS_TOKEN=
# "test" (default) or "live". Only switch to live once NSIA has approved the integration.
NSIA_ENV=test
# Optional: overrides the base URL entirely.
# NSIA_BASE_URL=

# Fortis Global External Motor API — see docs/fortis-integration.md
# The docs publish a literal sandbox test client ID/secret for this API
# (FGI-MOTOR-CLIENT / FGI-MOTOR-2026!) — safe to use here for testing, since
# submissions land in a temporary review table, not the live policy workflow.
FORTIS_CLIENT_ID=
FORTIS_CLIENT_SECRET=

# Tangerine Motor Insurance API — see docs/tangerine-integration.md
# Same UserID and APIKEY are used for both the Comprehensive and 3rd Party product lines.
TANGERINE_USER_ID=
TANGERINE_API_KEY=

# Cloudinary unsigned upload — turns a browser-uploaded vehicle photo into the
# public URL Tangerine's ImageUrlList requires. Create an unsigned upload
# preset in the Cloudinary dashboard and put its name here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Payloft Sandbox payment gateway — see docs/payloft-integration.md
# Must start with sk_test_ in sandbox.
PAYLOFT_SECRET_KEY=

# VerifyData (Virtuality) vehicle registration lookup — see docs/verifydata-integration.md
VERIFYDATA_SECRET_KEY=

# Admin policies dashboard — see docs/policies-dashboard.md
# A Neon connection string (directly, or via the Vercel Postgres integration,
# which is Neon under the hood) — @vercel/postgres speaks Neon's HTTP
# protocol, not raw Postgres wire protocol, so a self-hosted Postgres
# instance will not work here.
POSTGRES_URL=

# Optional outbound proxy used for all insurer/payment calls.
# FIXIE_URL=
